# Read by Cloudflare Pages (and Netlify). How long a browser may keep each kind of file.

# Code and styles have a unique name per build, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pictures and 3D models keep their names between builds: keep for a week, refresh in the background.
/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

/models/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=2592000

# The service worker must always be checked for a new version.
/sw.js
  Cache-Control: no-cache

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
